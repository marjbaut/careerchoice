<?xml version="1.0" encoding="UTF-8"?>
<aiml>
    <category>
        <pattern>*</pattern>
            <template>Hello! This is Amy, a career advisor for computer science program. May I have your name? (reply "my name is ..."</template>
    </category>
  
    <category>
        <pattern>My name is *</pattern>
            <template>Welcome <set name = "userName"><star/></set>! What are you currently studying?
                <reply>
                    <text>Computer Science</text>
                    <postback>CSD</postback>
                </reply>
                <reply>
                    <text>Non Computer Science Degree</text>
                    <postback>NCS</postback>
                </reply>
            </template>
    </category>
  
    <category>
        <pattern>NCS</pattern>
        <template><get name = "userName"/>! Unfortunately, this chat is only available for Computer Science students. Please reach out to your program mentor for assistance with your career opportunities. Goodbye</template>
    </category> 
  
    <category>
        <pattern>CSD</pattern>
            <template>Ok <get name = "userName"/>, which of these areas of computer science interests you the most?
                <reply>
                    <text>Data</text>
                    <postback>DATA</postback>
                </reply>
                <reply>
                    <text>Coding</text>
                    <postback>CODE</postback>
                </reply>
                <reply>
                    <text>Security</text>
                    <postback>SEC</postback>
                </reply>
            </template>
    </category>
  
    <category>
        <pattern>DATA</pattern>
        <template> <get name = "userName"/>, Here is a list of jobs that you may be interested of:<br/>
            Data Scientist<br/>
            Data Analyst<br/>
            Data Engineer<br/>
            Business Intelligence Analyst<br/>
            Machine Learning Engineer<br/><br/>
            To start again, say "hi"
        </template>
    </category>  
    
    <category>
        <pattern>CODE</pattern>
        <template><get name = "userName"/>, Here is a list of job that you may be interested of:<br/>
            Software Developer<br/>
            Web Developer<br/>
            Mobile App Developer<br/>
            Game Developer<br/>
            Full Stack Developer<br/><br/>
            To start again, say "hi"
        </template>
    </category>
    
    <category>
        <pattern>SEC</pattern>
        <template><get name = "userName"/>, Here is a list of job that you may be interested of:<br/>
            Cybersecurity Analyst<br/>
            Information Security Specialist<br/>
            Security Engineer<br/>
            Penetration Tester<br/>
            Security Consultant<br/><br/>
            To start again, say "hi"
        </template>
    </category>  
  
  
</aiml>
